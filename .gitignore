# dependencies
node_modules

# testing
apps/frontend/coverage/

# svelte / vite
apps/frontend/.svelte-kit/
apps/frontend/build/
# the native build a release makes alongside the web one (scripts/deploy-ios.ts)
apps/frontend/.svelte-kit-ios/
apps/frontend/build-ios/

# capacitor — the Xcode project is committed, its build products are not.
# The rest lives in apps/frontend/ios/.gitignore, next to what it ignores.
apps/frontend/android/

# apple release artefacts
.bundle/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# nitro
apps/backend/.output/
apps/backend/.nitro/

# the web build the backend serves
apps/backend/public/

# misc
.DS_Store
*.pem
npm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# the macOS app a release stages for the website to serve
dist/

# per-target deploy logs (devkit deploy)
.devkit/

# vercel
.vercel

# typescript
*.tsbuildinfo

# stray Next.js dev types (legacy web app; regenerated by tooling)
.next/

# SwiftPM build products
.build/
