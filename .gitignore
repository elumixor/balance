# dependencies
node_modules

# testing
apps/frontend/coverage/

# svelte / vite
apps/frontend/.svelte-kit/
apps/frontend/build/
# every native shell carries its own copy of the web app, and `devkit build` builds them beside
# each other — so each gets its own output and kit directory
apps/frontend/.svelte-kit-*/
apps/frontend/build-*/

# capacitor — the Xcode project is committed, its build products are not.
# The rest lives in apps/frontend/ios/.gitignore, next to what it ignores.
apps/frontend/android/

# apple release artefacts
.bundle/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# nitro
apps/backend/.output/
apps/backend/.nitro/

# the web build the backend serves
apps/backend/public/

# misc
.DS_Store
*.pem
npm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# the macOS app a release stages for the website to serve
dist/

# per-target deploy logs (devkit deploy)
.devkit/

# vercel
.vercel

# typescript
*.tsbuildinfo

# stray Next.js dev types (legacy web app; regenerated by tooling)
.next/

# SwiftPM build products
.build/

# Playwright MCP scratch output
.playwright-mcp/

# Claude Code worktrees and local state
.claude/
