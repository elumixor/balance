source "https://rubygems.org"

gem "fastlane"
# Ruby 3.3.11+ on the CI runner dropped these from its default gems, but
# fastlane's bundled actions (representable / google-apis) still require them.
gem "multi_json"
gem "abbrev"
gem "mutex_m"
# `expo prebuild` shells out to `pod install` as part of the beta lane. Since the
# whole lane runs under `bundle exec`, Bundler intercepts that subprocess call too
# and refuses to run a `pod` binstub that isn't declared in this Gemfile.
gem "cocoapods"
