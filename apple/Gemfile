source "https://rubygems.org"

gem "fastlane"
# Ruby 3.3.11+ on the CI runner dropped these from its default gems, but
# fastlane's bundled actions (representable / google-apis) still require them.
gem "multi_json"
gem "abbrev"
gem "mutex_m"
# The beta lane stamps the version across the host, watch and widget targets itself.
# (Capacitor 8 wires its plugins through Swift Package Manager, so there is no CocoaPods
# step in this project at all.)
gem "xcodeproj"
