require "fileutils"

default_platform(:ios)

# fastlane's `sh` action runs from the "fastlane" subfolder (where this Fastfile
# lives) by default, not the project root — resolve absolute paths from here so
# FileUtils (real Ruby cwd) and sh (fastlane's own cwd) never disagree.
APPLE_DIR = File.expand_path("..", __dir__)
ROOT_DIR = File.expand_path("../..", __dir__)
FRONTEND_DIR = File.join(ROOT_DIR, "apps", "frontend")
IOS_DIR = File.join(FRONTEND_DIR, "ios")

PROJECT = File.join(IOS_DIR, "Balance.xcodeproj")
WORKSPACE = File.join(IOS_DIR, "Balance.xcworkspace")
SCHEME = "Balance"
APP_IDENTIFIER = "com.elumixor.balance"
WATCH_IDENTIFIER = "com.elumixor.balance.watchkitapp"
WIDGET_IDENTIFIER = "com.elumixor.balance.watchkitapp.widget"
APP_GROUP = "group.com.elumixor.balance"
TEAM_ID = "464K6UHCU4"

def make_api_key
  key_args = { key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
               issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
               in_house: false }
  if ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    key_args[:key_filepath] = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  else
    key_args[:key_content] = ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT")
    key_args[:is_key_content_base64] = false
  end
  app_store_connect_api_key(**key_args)
end

platform :ios do
  # One-time (idempotent) provisioning: registers the watch + widget bundle
  # IDs on the Developer Portal so they exist before sigh runs. The App Group
  # itself (and ticking it on each ID) must be done once via an interactive
  # Xcode GUI session — the App Store Connect API cannot create App Groups.
  # Idempotent & non-fatal.
  desc "Register watch/widget bundle IDs (idempotent)"
  lane :setup_watch do
    require "spaceship"
    begin
      token = Spaceship::ConnectAPI::Token.create(
        key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
        issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
        filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"]
      )
      Spaceship::ConnectAPI.token = token
      ensure_bundle_id(WATCH_IDENTIFIER, "Balance Watch App")
      ensure_bundle_id(WIDGET_IDENTIFIER, "Balance Watch Widget")
    rescue => e
      UI.important("setup_watch (non-fatal): #{e.message}")
    end
    UI.message("App Group #{APP_GROUP} must exist and be enabled on:")
    UI.message("  #{APP_IDENTIFIER}, #{WATCH_IDENTIFIER}, #{WIDGET_IDENTIFIER}")
  end

  desc "Build and upload a new TestFlight build"
  lane :beta do
    # The iOS host + watch app + widget are all generated into one project by
    # `expo prebuild` (host from apps/frontend, watch/widget from apps/frontend/targets
    # via the @bacons/apple-targets config plugin — see apps/frontend/app.json and
    # apps/frontend/plugins/withBalanceKitSwiftPackage.js for how BalanceKit gets linked
    # in). `--clean` regenerates `apps/frontend/ios` from scratch every run, mirroring
    # what `xcodegen generate` used to do for the old hand-written project.
    sh("cd #{FRONTEND_DIR} && bunx expo prebuild -p ios --clean")

    api_key = make_api_key

    next_build = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      api_key: api_key,
      initial_build_number: 0
    ) + 1

    increment_build_number(
      xcodeproj: PROJECT,
      build_number: next_build
    )

    # Keep the embedded watch app + widget version-locked to the host app, or
    # App Store validation rejects the upload.
    app_version = get_info_plist_value(path: File.join(IOS_DIR, "Balance", "Info.plist"), key: "CFBundleShortVersionString")
    [
      File.join(FRONTEND_DIR, "targets", "watch", "Info.plist"),
      File.join(FRONTEND_DIR, "targets", "watch-widget", "Info.plist"),
    ].each do |plist|
      set_info_plist_value(path: plist, key: "CFBundleShortVersionString", value: app_version)
      set_info_plist_value(path: plist, key: "CFBundleVersion", value: next_build.to_s)
    end

    # Make sure the watch + widget identifiers exist before sigh runs.
    setup_watch

    # One App Store profile per signed target (force re-fetch — CI is stateless).
    app_profile = make_profile(api_key, APP_IDENTIFIER)
    watch_profile = make_profile(api_key, WATCH_IDENTIFIER)
    widget_profile = make_profile(api_key, WIDGET_IDENTIFIER)

    update_code_signing_settings(
      path: PROJECT, use_automatic_signing: false, team_id: TEAM_ID,
      targets: ["Balance"], code_sign_identity: "Apple Distribution",
      profile_name: app_profile, build_configurations: ["Release"]
    )
    update_code_signing_settings(
      path: PROJECT, use_automatic_signing: false, team_id: TEAM_ID,
      targets: ["Balance Watch App"], code_sign_identity: "Apple Distribution",
      profile_name: watch_profile, build_configurations: ["Release"]
    )
    update_code_signing_settings(
      path: PROJECT, use_automatic_signing: false, team_id: TEAM_ID,
      targets: ["Balance Watch Widget Extension"], code_sign_identity: "Apple Distribution",
      profile_name: widget_profile, build_configurations: ["Release"]
    )

    # `xcodebuild -exportArchive` has a reproducible "Unknown Distribution Error" /
    # "expected one {} but found app-store" bug on current Xcode (26.x) for this
    # archive shape (iOS app embedding a watchOS app + widget extension) — confirmed
    # both locally and on GitHub's macOS runner. gym's archive step itself works fine
    # (skip_package_ipa: true stops before the broken export), so we archive via gym
    # and then hand-package the IPA ourselves from the already-signed .app, exactly
    # mirroring what a successful `xcodebuild archive` + manual `zip` produces.
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      skip_package_ipa: true,
      export_method: "app-store"
    )

    archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    app_path = File.join(archive_path, "Products", "Applications", "#{SCHEME}.app")
    ipa_dir = File.join(APPLE_DIR, "build")
    ipa_path = File.join(ipa_dir, "Balance.ipa")
    FileUtils.mkdir_p(File.join(ipa_dir, "Payload"))
    FileUtils.rm_rf(File.join(ipa_dir, "Payload", "#{SCHEME}.app"))
    FileUtils.cp_r(app_path, File.join(ipa_dir, "Payload", "#{SCHEME}.app"))
    sh("cd #{ipa_dir} && rm -f Balance.ipa && zip -r -y Balance.ipa Payload")

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      ipa: ipa_path
    )
  end
end

def make_profile(api_key, app_identifier)
  sigh(api_key: api_key, app_identifier: app_identifier, force: true)
  lane_context[SharedValues::SIGH_NAME]
end

def ensure_bundle_id(identifier, name)
  existing = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == identifier }
  return existing if existing
  UI.message("Registering bundle id #{identifier}")
  Spaceship::ConnectAPI::BundleId.create(name: name, identifier: identifier, platform: "IOS", seed_id: TEAM_ID)
end
