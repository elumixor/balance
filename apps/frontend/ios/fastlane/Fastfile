require "fileutils"

default_platform(:ios)

PROJECT = "App/App.xcodeproj"
SCHEME = "App"
APP_IDENTIFIER = "com.elumixor.balance"
WATCH_IDENTIFIER = "com.elumixor.balance.watchkitapp"
WIDGET_IDENTIFIER = "com.elumixor.balance.watchkitapp.widget"
APP_GROUP = "group.com.elumixor.balance"
TEAM_ID = "464K6UHCU4"

WATCH_TARGET = "BalanceWatch"
WIDGET_TARGET = "BalanceWatchWidget"

def make_api_key
  key_args = { key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
               issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
               in_house: false }
  if ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    key_args[:key_filepath] = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  else
    key_args[:key_content] = ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT")
    key_args[:is_key_content_base64] = false
  end
  app_store_connect_api_key(**key_args)
end

platform :ios do
  # One-time (idempotent) provisioning: registers the watch + widget bundle
  # IDs on the Developer Portal so they exist before sigh runs. Capabilities —
  # the App Group in particular — have to be ticked on each ID by hand in the
  # portal; the App Store Connect API key cannot do it. Non-fatal.
  desc "Register watch/widget bundle IDs (idempotent)"
  lane :setup_watch do
    require "spaceship"
    begin
      token = Spaceship::ConnectAPI::Token.create(
        key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
        issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
        filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"]
      )
      Spaceship::ConnectAPI.token = token
      ensure_bundle_id(WATCH_IDENTIFIER, "Balance Watch App")
      ensure_bundle_id(WIDGET_IDENTIFIER, "Balance Watch Widget")
    rescue => e
      UI.important("setup_watch (non-fatal): #{e.message}")
    end
    UI.message("Watch/widget snapshot sharing needs App Group #{APP_GROUP} enabled on:")
    UI.message("  #{APP_IDENTIFIER}, #{WATCH_IDENTIFIER}, #{WIDGET_IDENTIFIER}")
  end

  desc "Build and upload a new TestFlight build"
  lane :beta do
    api_key = make_api_key

    next_build = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      api_key: api_key,
      initial_build_number: 0
    ) + 1

    increment_build_number(xcodeproj: PROJECT, build_number: next_build)

    # Keep the embedded watch app + widget version-locked to the host app, or
    # App Store validation rejects the upload.
    app_version = get_info_plist_value(path: "App/App/Info.plist", key: "CFBundleShortVersionString")
    ["App/WatchApp/Info.plist", "App/WatchWidget/Info.plist"].each do |plist|
      set_info_plist_value(path: plist, key: "CFBundleShortVersionString", value: app_version)
      set_info_plist_value(path: plist, key: "CFBundleVersion", value: next_build.to_s)
    end

    # Make sure the watch + widget identifiers exist before sigh runs.
    setup_watch

    # One App Store profile per signed target (force re-fetch — CI is stateless).
    app_profile = make_profile(api_key, APP_IDENTIFIER)
    watch_profile = make_profile(api_key, WATCH_IDENTIFIER)
    widget_profile = make_profile(api_key, WIDGET_IDENTIFIER)

    [[SCHEME, app_profile], [WATCH_TARGET, watch_profile], [WIDGET_TARGET, widget_profile]].each do |target, profile|
      update_code_signing_settings(
        path: PROJECT, use_automatic_signing: false, team_id: TEAM_ID,
        targets: [target], code_sign_identity: "Apple Distribution",
        profile_name: profile, build_configurations: ["Release"]
      )
    end

    # `xcodebuild -exportArchive` has a reproducible "Unknown Distribution Error" /
    # `exportOptionsPlist error for key "method" expected one {} but found app-store`
    # on current Xcode (26.x) for this archive shape — an iOS app embedding a watchOS
    # app + widget extension. Confirmed both locally and on GitHub's macOS runner, with
    # and without an explicit provisioningProfiles map. gym's archive step itself is
    # fine (skip_package_ipa: true stops before the broken export), so we archive via
    # gym and hand-package the IPA from the already-signed .app — exactly what a
    # successful `xcodebuild archive` + `zip` produces.
    #
    # Don't pass signing flags via xcargs either — they leak into the SPM dependency
    # targets (Capacitor plugins, ClerkKit) which can't be signed.
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      skip_package_ipa: true,
      export_method: "app-store"
    )

    archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    app_path = File.join(archive_path, "Products", "Applications", "#{SCHEME}.app")
    ipa_dir = File.expand_path("../build", __dir__)
    ipa_path = File.join(ipa_dir, "App.ipa")
    FileUtils.mkdir_p(File.join(ipa_dir, "Payload"))
    FileUtils.rm_rf(File.join(ipa_dir, "Payload", "#{SCHEME}.app"))
    FileUtils.cp_r(app_path, File.join(ipa_dir, "Payload", "#{SCHEME}.app"))
    sh("cd #{ipa_dir} && rm -f App.ipa && zip -r -y App.ipa Payload")

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      ipa: ipa_path
    )
  end
end

def make_profile(api_key, app_identifier)
  sigh(api_key: api_key, app_identifier: app_identifier, force: true)
  lane_context[SharedValues::SIGH_NAME]
end

def ensure_bundle_id(identifier, name)
  existing = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == identifier }
  return existing if existing
  UI.message("Registering bundle id #{identifier}")
  Spaceship::ConnectAPI::BundleId.create(name: name, identifier: identifier, platform: "IOS", seed_id: TEAM_ID)
end
