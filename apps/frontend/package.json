{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host --port 8081",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "sync": "cap sync ios",
    "assets": "bun scripts/assets.ts",
    "ios": "CAPACITOR_LIVE_RELOAD=true cap sync ios && cap open ios",
