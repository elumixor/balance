{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Balance",
  "version": "0.1.0",
  "identifier": "com.elumixor.balance.desktop",
  "mainBinaryName": "Balance",
  "build": {
    "devUrl": "http://localhost:8081",
    "frontendDist": "../build",
    "beforeBuildCommand": "VITE_API_BASE_URL=https://balance-app-mauve.vercel.app vite build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Balance",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["balance-desktop"]
      }
    }
  }
}
