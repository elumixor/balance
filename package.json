{
  "name": "balance-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "devkit dev",
    "build": "devkit build",
    "deploy": "devkit deploy",
    "test": "bun run --filter '*' test",
    "check": "bun run --filter '*' check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "version:sync": "devkit version"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@elumixor/devkit": "^0.10.1",
    "@types/node": "^20",
    "typescript": "^5"
  },
  "devkit": {
    "generate": {
      "command": "bunx nitro-client",
      "cwd": "apps/backend"
    },
    "dev": {
      "web": {
        "processes": {
          "backend": {
            "filter": "@balance/backend",
            "port": 3100,
            "color": "blue"
          },
          "frontend": {
            "port": 8081,
            "color": "magenta",
            "open": true
          }
        }
      },
      "mac": {
        "command": "bunx tauri dev",
        "cwd": "apps/frontend",
        "color": "yellow",
        "needs": [
          "web"
        ]
      },
      "iphone": {
        "type": "capacitor-ios",
        "color": "green",
        "needs": [
          "web"
        ],
        "options": {
          "frontendDir": "apps/frontend",
          "project": "apps/frontend/ios/App/App.xcodeproj",
          "scheme": "App",
          "bundleId": "com.elumixor.balance",
          "device": "iPhone 17 Pro",
          "derivedDataDir": "apps/frontend/ios/App/build/iphone",
          "port": 8081,
          "watch": [
            "apps/frontend/ios/App/App"
          ]
        }
      },
      "iwatch": {
        "type": "xcode-sim",
        "color": "cyan",
        "needs": [
          "web"
        ],
        "options": {
          "project": "apps/frontend/ios/App/App.xcodeproj",
          "scheme": "BalanceWatch",
          "sdk": "watchsimulator",
          "bundleId": "com.elumixor.balance.watchkitapp",
          "device": "Apple Watch Series 11 (46mm)",
          "derivedDataDir": "apps/frontend/ios/App/build/sim",
          "previewEnv": "BALANCE_DEV_AUTH",
          "watch": [
            "apps/frontend/ios/App/WatchApp",
            "apps/frontend/ios/App/WatchWidget",
            "apps/frontend/ios/BalanceKit/Sources"
          ]
        }
      }
    },
    "build": {
      "web": {
        "type": "web",
        "options": {
          "frontendDir": "apps/frontend",
          "backendDir": "apps/backend",
          "apiPrefixes": [
            "mobile",
            "health"
          ],
          "include": {
            "dist/download": "download"
          }
        }
      },
      "mac": {
        "type": "tauri-macos",
        "options": {
          "frontendDir": "apps/frontend"
        }
      },
      "iphone": {
        "type": "capacitor-ios",
        "options": {
          "frontendDir": "apps/frontend",
          "project": "apps/frontend/ios/App/App.xcodeproj",
          "scheme": "App",
          "derivedDataDir": "apps/frontend/ios/App/build/iphone"
        }
      },
      "iwatch": {
        "type": "xcode",
        "options": {
          "project": "apps/frontend/ios/App/App.xcodeproj",
          "scheme": "BalanceWatch",
          "sdk": "watchsimulator",
          "derivedDataDir": "apps/frontend/ios/App/build/sim"
        }
      }
    },
    "deploy": {
      "mac": {
        "type": "tauri-macos"
      },
      "updater": {
        "command": "bun apps/frontend/scripts/stage-updater.ts",
        "needs": [
          "mac"
        ]
      },
      "web": {
        "type": "vercel",
        "needs": [
          "updater"
        ]
      },
      "iphone": {
        "type": "fastlane-ios",
        "options": {
          "defaultApiBaseUrl": "https://balance-app-mauve.vercel.app"
        }
      }
    },
    "version": {
      "source": "apps/frontend/src-tauri/tauri.conf.json",
      "packages": [
        "package.json",
        "apps/frontend/package.json"
      ],
      "cargo": [
        "apps/frontend/src-tauri/Cargo.toml"
      ],
      "xcodeProjects": [
        "apps/frontend/ios/App/App.xcodeproj/project.pbxproj"
      ],
      "marketingVersionPlists": [
        "apps/frontend/ios/App/App/Info.plist"
      ],
      "plists": [
        "apps/frontend/ios/App/WatchApp/Info.plist",
        "apps/frontend/ios/App/WatchWidget/Info.plist"
      ]
    }
  }
}
