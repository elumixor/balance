{
  "name": "balance-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "bun scripts/build-vercel.ts",
    "dev": "devkit",
    "dev:open": "devkit --open",
    "check": "bun --filter frontend check",
    "ios": "bun --filter frontend ios",
    "sim:watch": "bun scripts/sim.ts",
    "desktop": "bun --filter frontend desktop",
    "desktop:install": "bun --filter frontend desktop:install",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:e2e": "playwright test",
    "deploy": "devkit deploy",
    "deploy:vercel": "devkit deploy vercel",
    "deploy:ios": "devkit deploy ios",
    "deploy:desktop": "devkit deploy desktop",
    "release:ios": "git tag ios-v$(date +%Y%m%d%H%M%S) && git push origin --tags"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@elumixor/devkit": "^0.7.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "typescript": "^5"
  },
  "devkit": {
    "apps": [
      {
        "name": "backend",
        "filter": "@balance/backend",
        "port": 3100,
        "color": "blue"
      },
      {
        "name": "frontend",
        "port": 8081,
        "color": "magenta",
        "open": true
      }
    ],
    "deploy": [
      {
        "name": "desktop",
        "type": "tauri-macos",
        "color": "yellow"
      },
      {
        "name": "vercel",
        "type": "vercel",
        "color": "magenta",
        "needs": [
          "desktop"
        ]
      },
      {
        "name": "ios",
        "type": "fastlane-ios",
        "color": "cyan",
        "options": {
          "backendDir": "apps/backend",
          "defaultApiBaseUrl": "https://balance-app-mauve.vercel.app"
        }
      }
    ]
  }
}
