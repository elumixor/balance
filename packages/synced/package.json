{
  "name": "@balance/synced",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./protocol": {
      "types": "./dist/types/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./client": {
      "types": "./dist/types/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/types/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/protocol.ts src/client/index.ts src/server/index.ts --outdir dist --target node --format esm --splitting --external zod && tsc -p tsconfig.types.json",
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^5",
    "zod": "^4.4.3"
  },
  "files": [
    "dist",
    "src"
  ]
}
